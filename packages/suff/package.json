{
    "name": "suff",
    "version": "0.1.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/idn-au/fuzzy-geometries.git",
        "directory": "packages/suff"
    },
    "keywords": [
        "vue3",
        "vue",
        "vuejs"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/suff.umd.cjs",
    "module": "./dist/suff.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/suff.js",
            "require": "./dist/suff.umd.cjs"
        },
        "./suff.css": {
            "import": "./dist/suff.css",
            "require": "./dist/suff.css"
        }
    },
    "types": "./dist/index.d.ts",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "test:unit": "vitest",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "preinstall": "npx only-allow pnpm"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "dependencies": {
        "@lucide/vue": "^1.21.0",
        "@tailwindcss/vite": "^4.3.1",
        "@terraformer/wkt": "^2.2.1",
        "@turf/turf": "^7.3.5",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "event-emitter-promisify": "^1.1.0",
        "jsonld-streaming-parser": "^5.0.1",
        "n3": "^2.0.4",
        "ol": "^10.9.0",
        "ol-contextmenu": "^5.4.0",
        "ol-ext": "^4.0.38",
        "reka-ui": "^2.10.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.1",
        "tw-animate-css": "^1.4.0",
        "vue3-openlayers": "^12.2.2"
    },
    "devDependencies": {
        "@types/geojson": "^7946.0.16",
        "@types/jsdom": "^28.0.3",
        "@types/n3": "^1.26.1",
        "@types/node": "^26.0.0",
        "@types/terraformer__wkt": "^2.0.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^29.1.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.2",
        "vite-plugin-vue-devtools": "^8.1.3",
        "vitest": "^4.1.9",
        "vue-tsc": "^3.3.5"
    }
